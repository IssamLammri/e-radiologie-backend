	"item": [
		{
			"name": "01 - Authentification",
			"item": [
				{
					"name": "Connexion utilisateur",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Connexion réussie', function () { pm.response.to.have.status(200); });",
									"if (pm.response.code === 200) {",
									"  const response = pm.response.json();",
									"  if (response.token) {",
									"    pm.collectionVariables.set('user_token', response.token);",
									"    pm.environment.set('user_token', response.token);",
									"  }",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/login_check",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"login_check"
							]
						},
						"description": "Enregistre automatiquement le JWT reçu dans `user_token`."
					},
					"response": []
				},
				{
