{% extends 'emails/base.html.twig' %}

{% block title %}
    Réinitialisation de votre mot de passe
{% endblock %}

{% block content %}

    <h1 style="
        margin: 0 0 24px;
        color: #111827;
        font-size: 24px;
    ">
        Réinitialisation du mot de passe
    </h1>

    <p style="margin: 0 0 16px;">
        Bonjour {{ user.firstName ?: '' }},
    </p>

    <p style="margin: 0 0 24px;">
        Nous avons reçu une demande de réinitialisation
        du mot de passe associé à votre compte e-Radiologie.
    </p>

    <table
        role="presentation"
        cellspacing="0"
        cellpadding="0"
        border="0"
        style="margin: 30px 0;"
    >
        <tr>
            <td style="
                background-color: #2563eb;
                border-radius: 8px;
            ">
                <a
                    href="{{ resetUrl }}"
                    style="
                        display: inline-block;
                        padding: 14px 24px;
                        color: #ffffff;
                        text-decoration: none;
                        font-weight: 600;
                    "
                >
                    Réinitialiser mon mot de passe
                </a>
            </td>
        </tr>
    </table>

    <p style="
        margin: 24px 0 0;
        color: #6b7280;
        font-size: 13px;
    ">
        Ce lien est temporaire.
    </p>

    <p style="
        margin: 12px 0 0;
        color: #6b7280;
        font-size: 13px;
    ">
        Si vous n'avez pas demandé la réinitialisation
        de votre mot de passe, ignorez simplement cet email.
    </p>

{% endblock %}
