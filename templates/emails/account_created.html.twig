{% extends 'emails/base.html.twig' %}

{% block title %}
    Bienvenue sur e-Radiologie
{% endblock %}

{% block content %}

    <h1 style="
        margin: 0 0 24px;
        color: #111827;
        font-size: 24px;
    ">
        Bienvenue sur e-Radiologie
    </h1>

    <p style="margin: 0 0 16px;">
        Bonjour {{ user.firstName ?: '' }},
    </p>

    <p style="margin: 0 0 16px;">
        Votre compte e-Radiologie a été créé avec succès.
    </p>

    <p style="margin: 0 0 24px;">
        Pour vous connecter, veuillez d'abord définir votre mot de passe en cliquant sur le bouton ci-dessous.
    </p>

    <table
        role="presentation"
        cellspacing="0"
        cellpadding="0"
        border="0"
        style="margin: 30px 0;"
    >
        <tr>
            <td
                style="
                    background-color: #2563eb;
                    border-radius: 8px;
                "
            >
                <a
                    href="{{ resetUrl }}"
                    style="
                        display: inline-block;
                        padding: 14px 24px;
                        color: #ffffff;
                        text-decoration: none;
                        font-weight: 600;
                    "
                >
                    Définir mon mot de passe
                </a>
            </td>
        </tr>
    </table>

    <p style="
        margin-top: 24px;
        color: #6b7280;
        font-size: 13px;
    ">
        Si vous n'êtes pas à l'origine de cette création de compte,
        veuillez contacter l'équipe e-Radiologie.
    </p>

{% endblock %}
