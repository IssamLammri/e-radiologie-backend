APP_ENV=dev
APP_DEBUG=1
APP_LOCAL_SETUP=1
APP_SECRET=change-me-for-your-environment
DEFAULT_URI=http://localhost:18740
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
PHPMYADMIN_URL=http://localhost:18741/
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@database:3306/${MYSQL_DATABASE}?serverVersion=8.4.0&charset=utf8mb4"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=e-radiologie-local-jwt

MAILER_DSN=null://null
BREVO_API_KEY=
# Pour activer Brevo, remplacer MAILER_DSN par :
# MAILER_DSN=brevo+api://${BREVO_API_KEY}@default
MAIL_FROM_EMAIL=contact@e-radiologie.test
MAIL_FROM_NAME="e-Radiologie"
FRONTEND_URL=http://localhost:3000
